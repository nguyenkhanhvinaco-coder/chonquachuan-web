# Copy file này thành .env.local (không commit lên git), điền giá trị thật
# lấy từ Supabase Dashboard → nút "Kết nối" → tab "Khung" (Next.js).
# Trên Vercel: nhập 2 giá trị này ở Project Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tuỳ chọn — link theo dõi Zalo OA (vd: https://zalo.me/xxxxxxxxxxxxxxxxx).
# Để trống thì nút "Kết bạn Zalo OA" trên trang thiệp Trung Thu sẽ tự ẩn.
# Điền khi OA đã được duyệt, rồi thêm biến này trên Vercel Project Settings.
NEXT_PUBLIC_ZALO_OA_URL=
